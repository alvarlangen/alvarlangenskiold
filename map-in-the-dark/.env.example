# Map imagery (optional). By default the game uses its bundled satellite imagery (10 m, soft in close-ups) and
# needs no settings. For sharp imagery set VITE_MAP_PROVIDER=esri and your key; the bundled imagery is the fallback.
# Copy to .env.local for local development, or set the same variables in Netlify/Vercel.
#
# local    bundled Sentinel-2 imagery (default)
# none     only the bundled Natural Earth vector map
# esri     ArcGIS Location Platform, World Imagery (API key with "Basemaps" privilege)
# maptiler MapTiler Cloud, Satellite
# mapbox   Mapbox, Satellite raster tiles (public access token)
# custom   Any XYZ imagery: set VITE_MAP_URL (with {z} {x} {y} and optionally {key}) and VITE_MAP_ATTRIBUTION
VITE_MAP_PROVIDER=local
VITE_MAP_KEY=
# VITE_MAP_URL=https://example.com/tiles/{z}/{x}/{y}.jpg?key={key}
# VITE_MAP_ATTRIBUTION=© Example imagery
