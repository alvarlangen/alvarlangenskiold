{
  "name": "map-in-the-dark",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Map in the Dark — a daily geography game where a dark map lights up step by step.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src tests scripts",
    "qa": "node scripts/qa.mjs",
    "qa:imagery": "node scripts/qa-imagery.mjs",
    "data": "node scripts/build-countries.mjs && node scripts/build-cities.mjs && node scripts/build-flags.mjs && node --max-old-space-size=6000 scripts/build-tiles.mjs",
    "images": "node scripts/build-images.mjs"
  },
  "dependencies": {
    "preact": "^11.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "all-the-cities": "^3.1.0",
    "cities.json": "^1.1.65",
    "d3-geo": "^3.1.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "flag-icons": "^7.6.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "polygon-clipping": "^0.15.7",
    "prettier": "^3.9.10",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  }
}
